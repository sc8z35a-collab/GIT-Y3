{
  "name": "janken-kiwami-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "High-Resolution Photorealistic 3D Rock-Scissors-Paper featuring JNV1.0 Cognitive NPC Core, KHDR Pipeline, and Shadow Flame 1.0 Flash/Pro",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test:jnv1": "tsx src/engine/jnv1/runBenchmarkCli.ts",
    "test:jhand": "tsx src/engine/jhand/runJHandTest.ts",
    "test:jsound": "tsx src/engine/jsound/runJSoundTest.ts",
    "test:khdr5k": "tsx src/graphics/runPhoto5KTest.ts",
    "test:nexttech": "tsx src/engine/runNextTechTest.ts",
    "test:handdetail": "tsx src/engine/handdetail/runHandDetailTest.ts",
    "test:all": "npm run test:jnv1 && npm run test:jhand && npm run test:jsound && npm run test:khdr5k && npm run test:nexttech && npm run test:handdetail"
  },
  "dependencies": {
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/three": "^0.174.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
